# Sao chep file nay thanh .env (cung thu muc) roi dien gia tri.
# KHONG commit file .env len git.

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# service_role / secret key: CHI de tren Pi, tuyet doi khong dua len website hay git
SUPABASE_SERVICE_KEY=

# --- Thiet bi ---
# Ma duy nhat cho moi Pi (chu thuong, khong dau, khong khoang trang)
DEVICE_ID=pi-01
# Ten va vi tri hien thi ban dau (sau do admin sua tren website)
DEVICE_NAME=Camera phong khach
DEVICE_LOCATION=Tang 1

# --- Ket noi noi bo ---
# Flask cua detect_v3/4_realtime.py
PI_URL=http://127.0.0.1:5000
# IP cua hop ESP32 trong mang LAN (de trong neu khong co)
ESP32_IP=

# --- Gateway camera live ---
# 127.0.0.1: chi cloudflared tren Pi truy cap duoc (an toan nhat)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
STREAM_MAX_FPS=10
STREAM_MAX_VIEWERS=4
# Domain website duoc goi API (phan cach dau phay). * = cho phep tat ca (van can token dang nhap)
ALLOWED_ORIGINS=*

# --- Dua camera ra Internet ---
# quick = Cloudflare quick tunnel mien phi (URL doi moi lan khoi dong, agent tu cap nhat)
# off   = khong mo tunnel
TUNNEL=quick
CLOUDFLARED_PATH=cloudflared
# Neu da co ten mien rieng (named tunnel), dien URL co dinh o day va dat TUNNEL=off
PUBLIC_STREAM_URL=

# --- Chu ky (giay) ---
STATUS_POLL_S=1
ESP32_POLL_S=5
HEARTBEAT_S=10
